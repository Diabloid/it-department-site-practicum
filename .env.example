# ASP.NET Core Environment Variables Configuration
ASPNETCORE_ENVIRONMENT=Development

# Database Configuration
ConnectionStrings__DefaultConnection=server=localhost;port=3306;database=it_department_db;user=root;password=your_db_password

# API Security (Module 3: API Protection)
ApiKey__SecretKey=your-secure-api-key-here-12345

# Microsoft Entra ID (Azure AD) Authentication
EntraId__TenantId=00000000-0000-0000-0000-000000000000
EntraId__ClientId=00000000-0000-0000-0000-000000000000
EntraId__ClientSecret=your_entra_id_client_secret_placeholder

# Google Drive Integration (Optional)
GoogleDrive__ServiceAccountKeyPath=path/to/credentials.json
GoogleDrive__FolderId=your_google_drive_folder_id
