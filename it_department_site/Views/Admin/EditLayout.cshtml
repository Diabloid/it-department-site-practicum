@model SiteSettings

<h2>Редагування сайту</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<form method="post" asp-action="LayoutSettings" asp-controller="Admin" enctype="multipart/form-data">
    <div class="mb-3">
        <label>Назва сайту (в хедері):</label>
        <input type="text" class="form-control" name="SiteTitle" value="@Model.SiteTitle" />
    </div>

    <div class="mb-3">
        <label for="logoFile">Логотип сайту:</label>
        @if (!string.IsNullOrEmpty(Model.SiteLogoUrl))
        {
            <div class="mb-2">
                <img src="@Model.SiteLogoUrl" alt="Поточний логотип" style="max-height: 80px;" />
            </div>
        }
        <input type="file" class="form-control" id="logoFile" name="logoFile" accept="image/*" />
    </div>

    <div class="mb-3">
        <label for="HomePageId">Головна сторінка сайту:</label>
        <select class="form-control" id="HomePageId" name="HomePageId">
            <option value="">— не обрано —</option>
            @foreach (var p in ViewBag.Pages as List<it_department_site.Entities.Page>)
            {
                <option value="@p.Id" selected="@(Model.HomePageId == p.Id)">@p.Title</option>
            }
        </select>
    </div>

    <button type="submit" class="btn btn-success mt-3">💾 Зберегти</button>
</form>

@section Styles {
    <link rel="stylesheet" href="~/ckeditor5/ckeditor5.css" asp-append-version="true" />
}

@section Scripts {
    <script type="module">
        import { createEditor } from '/js/editor.js';

        createEditor(document.querySelector('#FooterHtml'))
            .catch(error => {
                console.error("❌ CKEditor не ініціалізувався:", error);
            });
    </script>
}