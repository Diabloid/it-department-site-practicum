@{
    ViewData["Title"] = "Admin Panel";
}

<div class="container">
    <div class="row">
        <!-- Сайдбар меню -->
        <div class="col-md-3">
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Pages')">View All Pages</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Users')">View All Users</a>
                <a class="btn btn-danger" asp-controller="Auth" asp-action="Logout">Вийти</a>
            </div>
        </div>

        <!-- Контентна область -->
        <div class="col-md-9">
            <div id="contentArea">
                <h4>Оберіть опцію</h4>
            </div>
        </div>
    </div>
</div>

<script>
    function loadContent(option) {
        fetch(`/Admin/${option}`)
            .then(response => response.text())
            .then(html => {
                document.getElementById("contentArea").innerHTML = html;
            })
            .catch(error => console.error("Error loading content:", error));
    }
</script>
