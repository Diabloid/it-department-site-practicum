@{
    ViewData["Title"] = "Admin Panel";
}

<script src="https://cdn.jsdelivr.net/npm/sortablejs@latest/Sortable.min.js"></script>
<script src="~/ckeditor/ckeditor.js"></script>
<script src="~/js/admin-post-autosave.js"></script>

<div class="container mt-5">
    <div class="row">
        <div class="col-md-3">
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Pages')">📄 View All Pages</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('MenuItems')">🧩 Manage Menu Items</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Users')">👤 View All Users</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('MainSlider')">📰 Слайдер головної сторінки</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Posts')">📰 Публікації</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Partners')">🤝 Управління партнерами</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Employees')">👩‍💻 Управління Співробітниками</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Graduates')">🤝 Управління випускниками</a>
                <a href="#" class="list-group-item list-group-item-action" onclick="loadContent('Disciplines')">📚 Дисципліни</a>
                <a class="list-group-item list-group-item-action" asp-action="LayoutSettings" asp-controller="Admin">
                    ⚙️ Редагувати хедер і футер
                </a>
                <a class="list-group-item list-group-item-action" asp-action="Settings" asp-controller="Admin">
                    🏢 Налаштування організації
                </a>
                <a class="list-group-item list-group-item-action" asp-action="EditTheme" asp-controller="Admin">
                    ⚙️ Редагувати тему
                </a>
                <a class="btn btn-danger mt-3" asp-controller="Auth" asp-action="Logout">🚪 Вийти</a>
            </div>
        </div>

        <div class="col-md-9">
            <div id="contentArea">
                <h4>Оберіть опцію</h4>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="adminConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Підтвердження</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрити"></button>
            </div>
            <div class="modal-body">
                <p id="adminConfirmMessage" class="mb-0"></p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Скасувати</button>
                <button type="button" class="btn btn-danger" id="adminConfirmOkBtn">Видалити</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let pendingConfirmForm = null;

        document.addEventListener("DOMContentLoaded", () => {
            const section = new URLSearchParams(window.location.search).get("section");
            if (section) {
                loadContent(section);
            }

            const confirmModalEl = document.getElementById('adminConfirmModal');
            const confirmOkBtn = document.getElementById('adminConfirmOkBtn');

            confirmOkBtn?.addEventListener('click', () => {
                if (!pendingConfirmForm) return;
                const form = pendingConfirmForm;
                pendingConfirmForm = null;
                bootstrap.Modal.getInstance(confirmModalEl)?.hide();
                submitForm(form);
            });

            confirmModalEl?.addEventListener('hidden.bs.modal', () => {
                pendingConfirmForm = null;
            });
        });

        function requestConfirmSubmit(form, message) {
            pendingConfirmForm = form;
            document.getElementById('adminConfirmMessage').textContent = message;
            bootstrap.Modal.getOrCreateInstance(document.getElementById('adminConfirmModal')).show();
        }

        function loadContent(option, params = '') {
            const url = `/Admin/${encodeURIComponent(option)}${params}`;
            fetch(url)
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Network response was not ok');
                    }
                    return response.text();
                })
                .then(html => {
                    destroyRichTextEditors();
                    document.getElementById("contentArea").innerHTML = html;

                    // 2. Якщо завантажили партнерів - вмикаємо перетягування
                    if (option === 'Partners') {
                        initPartnersDragAndDrop();
                    }

                    initRichTextEditors();
                    if (typeof initPostAutosave === 'function') initPostAutosave();
                })
                .catch(error => {
                    console.error("Error loading content:", error);
                    document.getElementById("contentArea").innerHTML = "<div class='alert alert-danger'>Помилка завантаження вмісту.</div>";
                });
        }

        // 3. Функція ініціалізації перетягування
        function initPartnersDragAndDrop() {
            var el = document.getElementById('partners-list');

            // Перевіряємо, чи існує список і чи завантажилась бібліотека
            if (el && typeof Sortable !== 'undefined') {
                Sortable.create(el, {
                    animation: 150,
                    filter: '.ignore-sort', // Ігноруємо кнопку "+"
                    onMove: function (evt) {
                        // Забороняємо перетягувати за кнопку "+"
                        return evt.related.className.indexOf('ignore-sort') === -1;
                    },
                    onEnd: function () {
                        // Збираємо новий порядок
                        var newOrder = [];
                        var items = el.querySelectorAll('.admin-partner-card');

                        items.forEach(function(item) {
                            newOrder.push(parseInt(item.getAttribute('data-id')));
                        });

                        // Відправляємо на сервер
                        fetch('/Admin/UpdatePartnerOrder', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(newOrder)
                        }).then(res => {
                            if (res.ok) console.log("Порядок збережено!");
                        });
                    }
                });
            }
        }

    let adminEditors = [];
    let adminEditorReady = [];

    function destroyRichTextEditors() {
        adminEditors.forEach(({ editor }) => {
            if (editor && typeof editor.destroy === 'function') {
                editor.destroy().catch(() => {});
            }
        });
        adminEditors = [];
        adminEditorReady = [];
    }

    function writeEditorDataToForm(form, name, data) {
        if (!form || !name) return;
        const fields = form.querySelectorAll(`[name="${name}"]`);
        if (fields.length === 0) {
            const hidden = document.createElement('input');
            hidden.type = 'hidden';
            hidden.name = name;
            hidden.value = data;
            form.appendChild(hidden);
            return;
        }
        fields.forEach(field => { field.value = data; });
    }

    function collectEditorValues(form) {
        const values = {};
        const apply = (name, editor, textarea) => {
            if (!editor || typeof editor.getData !== 'function') return;
            const data = editor.getData();
            const key = name || textarea?.getAttribute('name');
            if (textarea) textarea.value = data;
            if (key) {
                values[key] = data;
                writeEditorDataToForm(form, key, data);
            }
            if (typeof editor.updateSourceElement === 'function') {
                editor.updateSourceElement();
            }
        };

        adminEditors.forEach(({ name, editor, textarea, form: editorForm }) => {
            if (form && editorForm && editorForm !== form) return;
            apply(name, editor, textarea);
        });

        form?.querySelectorAll('textarea.editor').forEach(textarea => {
            apply(textarea.getAttribute('name'), textarea.ckeditorInstance, textarea);
        });

        return values;
    }

    function initRichTextEditors() {
        if (typeof FullEditor === 'undefined') return;
        document.querySelectorAll('#contentArea textarea.editor').forEach(textarea => {
            if (textarea.dataset.ckeReady === '1') return;
            textarea.dataset.ckeReady = '1';
            const form = textarea.closest('form');
            const fieldName = textarea.getAttribute('name');
            const ready = FullEditor.create(textarea, { ckfinder: { uploadUrl: '/ckeditor/upload' } })
                .then(editor => {
                    textarea.ckeditorInstance = editor;
                    adminEditors.push({ name: fieldName, editor, textarea, form });
                    const sync = () => writeEditorDataToForm(form, fieldName, editor.getData());
                    sync();
                    editor.model.document.on('change:data', sync);
                    return editor;
                })
                .catch(err => {
                    delete textarea.dataset.ckeReady;
                    console.error('CKEditor init error:', err);
                });
            adminEditorReady.push(ready);
        });
    }

    function syncRichTextEditors(form) {
        collectEditorValues(form);
    }

    function submitForm(form) {
        if (typeof event !== 'undefined' && event.preventDefault) event.preventDefault();

        const send = async () => {
            if (adminEditorReady.length) {
                await Promise.all(adminEditorReady.map(p => Promise.resolve(p).catch(() => {})));
            }
            const values = collectEditorValues(form);
            const body = new FormData(form);
            Object.entries(values).forEach(([name, data]) => body.set(name, data));
            const res = await fetch(form.action, {
                method: 'POST',
                body,
                credentials: 'same-origin'
            });
            const html = await res.text();
            destroyRichTextEditors();
            document.getElementById("contentArea").innerHTML = html;
            initRichTextEditors();
            if (typeof initPostAutosave === 'function') initPostAutosave();
        };

        send().catch(err => console.error('submitForm error:', err));
        return false;
    }

        // Приклад пагінації: loadPage(2) завантажить 2-гу сторінку
        function loadPage(page) {
            loadContent("Pages", `?page=${page}`);
        }

        function resetForm() {
          const modalLabel = document.getElementById('menuModalLabel');
          if(modalLabel) modalLabel.textContent = 'Створення пункту меню';

          if(document.getElementById('menuId')) document.getElementById('menuId').value = '';
          if(document.getElementById('menuName')) document.getElementById('menuName').value = '';
          if(document.getElementById('parentId')) document.getElementById('parentId').value = '';
          if(document.getElementById('pageId')) document.getElementById('pageId').value = '';
          if(document.getElementById('customUrl')) document.getElementById('customUrl').value = '';
          if(document.getElementById('sortOrder')) document.getElementById('sortOrder').value = '';
          if(document.getElementById('menuType')) document.getElementById('menuType').value = 'Item';
          if(document.getElementById('menuDisabled')) document.getElementById('menuDisabled').checked = false;
        }

        function fillFormFromButton(el) {
            const modalLabel = document.getElementById('menuModalLabel');
            if(modalLabel) modalLabel.textContent = 'Редагування пункту меню';
            if(document.getElementById('menuId')) document.getElementById('menuId').value = el.dataset.id;
            if(document.getElementById('menuName')) document.getElementById('menuName').value = el.dataset.name;
            if(document.getElementById('parentId')) document.getElementById('parentId').value = el.dataset.parentId;
            if(document.getElementById('pageId')) document.getElementById('pageId').value = el.dataset.pageId;
            if(document.getElementById('customUrl')) document.getElementById('customUrl').value = el.dataset.customUrl || '';
            if(document.getElementById('sortOrder')) document.getElementById('sortOrder').value = el.dataset.sortOrder;
            if(document.getElementById('menuType')) document.getElementById('menuType').value = el.dataset.type;
            if(document.getElementById('menuDisabled')) document.getElementById('menuDisabled').checked = el.dataset.disabled === 'true';
        }
        function addLinkRow(title = '', url = '', order = 0) {
            const container = document.getElementById('links-container');
            const row = document.createElement('div');
            const uniqueId = 'link-row' + Math.random().toString(36).slice(2, 9);
            row.className = 'row g-2 mb-2 align-items-center link-row';
            row.innerHTML = `
            <input type="hidden" name="ResourceLinks.Index" value="${uniqueId}" />
            <div class="col-4">
                <input type="text" name="ResourceLinks[${uniqueId}].Title" class="form-control" placeholder="Назва" value="${title}" required />
            </div>
            <div class="col-5">
                <input type="url" name="ResourceLinks[${uniqueId}].Url" class="form-control" placeholder="URL" value="${url}" required />
            </div>
            <div class="col-2">
                <input type="number" name="ResourceLinks[${uniqueId}].Order" class="form-control" placeholder="Порядок" value="${order}" required />
            </div>
            <div class="col-1">
                <button type="button" class="btn btn-sm btn-outline-danger" onclick="this.closest('.link-row').remove()">✕</button>
            </div>
        `;
            container.appendChild(row);
        }
    </script>
}
