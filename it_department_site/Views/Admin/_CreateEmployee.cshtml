@model it_department_site.Entities.Employee

<h4>Додати співробітника</h4>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul>
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post"
      asp-controller="Admin"
      asp-action="CreateEmployee"
      enctype="multipart/form-data"
      onsubmit="event.preventDefault(); submitForm(this); return false;">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Ім'я</label>
        <input asp-for="FirstName" class="form-control" required />
        <span asp-validation-for="FirstName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Прізвище</label>
        <input asp-for="LastName" class="form-control" required />
        <span asp-validation-for="LastName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Побатькові</label>
        <input asp-for="PatronymicName" class="form-control" />
        <span asp-validation-for="PatronymicName" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Спеціалізація</label>
        <input asp-for="Specialization" class="form-control" />
        <span asp-validation-for="Specialization" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Дисципліни, які викладає:</label>
        <div class="card p-3 border" style="max-height: 180px; overflow-y: auto;">
            @if (ViewBag.AllDisciplines != null)
            {
                var disciplines = (IEnumerable<it_department_site.Entities.Discipline>)ViewBag.AllDisciplines;
                if (disciplines.Any())
                {
                    @foreach (var disc in disciplines.OrderBy(d => d.SortOrder))
                    {
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="selectedDisciplines"
                                   value="@disc.Id"
                                   id="create_disc_@disc.Id" />
                            <label class="form-check-label" for="create_disc_@disc.Id">
                                @disc.Name
                            </label>
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted small">Список дисциплін порожній. Додайте їх у розділі "Дисципліни".</span>
                }
            }
            else
            {
                <span class="text-muted small">Не вдалося завантажити список дисциплін.</span>
            }
        </div>
        <div class="form-text">Оберіть предмети, які будуть закріплені за цим викладачем.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Фото</label>
        <input type="file" name="photoFile" class="form-control" accept="image/*" />
        <div class="form-text">Або файл <code>photo.png</code> / <code>фото.jpg</code> у папці Drive.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Інформація</label>
        <textarea asp-for="Bio" id="EmployeeBioCreate" class="form-control editor" rows="10"></textarea>
        <span asp-validation-for="Bio" class="text-danger"></span>
        <div class="form-text">Цей текст з’являється на вкладці «Інформація» на сторінці викладача.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Електронна пошта</label>
        <input asp-for="Email" class="form-control" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Папка сертифікатів (Google Drive)</label>
        <input asp-for="GoogleDriveFolderUrl" class="form-control"
               placeholder="https://drive.google.com/drive/folders/..." />
        <div class="form-text">Після збереження підтягнеться фото з папки. Сертифікати (до 15) оберіть у редагуванні викладача.</div>
    </div>

    <button class="btn btn-success">Зберегти</button>
    <button type="button" class="btn btn-secondary" onclick="loadContent('Employees')">Назад</button>
</form>