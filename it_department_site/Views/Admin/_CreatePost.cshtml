@model it_department_site.Entities.Post

<h4>Створити публікацію</h4>

<form method="post"
      asp-action="CreatePost"
      enctype="multipart/form-data"
      onsubmit="return submitForm(this)">

    @Html.AntiForgeryToken()

    <div class="mb-3">
        <label class="form-label">Назва</label>
        <input asp-for="Title" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Slug</label>
        <input asp-for="Slug" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Короткий опис</label>
        <input asp-for="Excerpt" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Контент</label>
        <textarea asp-for="Content" rows="6" class="form-control" required></textarea>
    </div>

   <div class="mb-3">
    <label class="form-label">Обкладинка </label>
    <input type="file" name="thumbnailFile" class="form-control" 
           accept=".jpg,.jpeg,.png,.webp" 
           onchange="checkSquareImage(this)" />
    <div class="form-text">
        Фото повинно мати <b>однакову ширину та висоту</b> (квадрат).
    </div>
</div>



    <button class="btn btn-success">Зберегти</button>
    <button type="button" class="btn btn-secondary" onclick="loadContent('Posts')">Назад</button>
</form>