@model it_department_site.Entities.Employee

<h4>Редагувати співробітника</h4>

@if (!ViewData.ModelState.IsValid)
{
    <div class="alert alert-danger">
        <ul class="mb-0">
            @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
            {
                <li>@error.ErrorMessage</li>
            }
        </ul>
    </div>
}

<form method="post"
      asp-controller="Admin"
      asp-action="EditEmployee"
      enctype="multipart/form-data"
      onsubmit="event.preventDefault(); submitForm(this); return false;">

    @Html.AntiForgeryToken()

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label class="form-label">Ім'я</label>
        <input asp-for="FirstName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Прізвище</label>
        <input asp-for="LastName" class="form-control" required />
    </div>

    <div class="mb-3">
        <label class="form-label">Побатькові</label>
        <input asp-for="PatronymicName" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Спеціалізація</label>
        <input asp-for="Specialization" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label fw-bold">Дисципліни, які викладає:</label>
        <div class="card p-3 border" style="max-height: 180px; overflow-y: auto;">
            @if (ViewBag.AllDisciplines != null)
            {
                var disciplines = (IEnumerable<Discipline>)ViewBag.AllDisciplines;
                if (disciplines.Any())
                {
                    @foreach (var disc in disciplines.OrderBy(d => d.SortOrder))
                    {
                        bool isChecked = Model?.Disciplines?.Any(d => d.Id == disc.Id) ?? false;
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox"
                                   name="selectedDisciplines"
                                   value="@disc.Id"
                                   id="edit_disc_@disc.Id"
                                   @(isChecked ? "checked" : "") />
                            <label class="form-check-label" for="edit_disc_@disc.Id">
                                @disc.Name
                            </label>
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted small">Список дисциплін порожній.</span>
                }
            }
        </div>
        <div class="form-text">Оберіть предмети, які будуть закріплені за цим викладачем.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Фото</label>
        @if (!string.IsNullOrEmpty(Model.PhotoUrl))
        {
            <div class="mb-2">
                <img src="@Model.PhotoUrl" alt="Фото" style="height:80px; border-radius:8px;" />
            </div>
        }
        <input type="file" name="photoFile" class="form-control" accept="image/*" />
        <div class="form-text">
            Або покладіть у папку Drive файл <code>photo.png</code> / <code>фото.jpg</code> (будь-який формат зображення) — підтягнеться автоматично, якщо не завантажите файл тут.
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Інформація</label>
        <textarea asp-for="Bio" id="EmployeeBioEdit" class="form-control editor" rows="10"></textarea>
        <div class="form-text">Цей текст з’являється на вкладці «Інформація» на сторінці викладача.</div>
    </div>

    <div class="mb-3">
        <label class="form-label">Електронна пошта</label>
        <input asp-for="Email" class="form-control" />
    </div>

    <div class="mb-3">
        <label class="form-label">Папка (Google Drive)</label>
        <input asp-for="GoogleDriveFolderUrl" class="form-control"
               placeholder="https://drive.google.com/drive/folders/..." />
        <div class="form-text">Після збереження оновиться фото з папки (якщо є photo/фото) і список сертифікатів нижче.</div>
    </div>

    @{
        ViewBag.HasDriveFolder = Model.GoogleDriveFolderUrl;
    }
    @if (!string.IsNullOrWhiteSpace(Model.GoogleDriveFolderUrl))
    {
        @await Html.PartialAsync("_DriveCertificatePicker")
    }

    <button class="btn btn-success">Зберегти</button>
    <button type="button" class="btn btn-secondary" onclick="loadContent('Employees')">Назад</button>
</form>
