@model IEnumerable<it_department_site.Entities.Graduate>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Випускники</h4>
    <button class="btn btn-success" onclick="loadContent('CreateGraduate')">
        + Додати випускника
    </button>
</div>

<table class="table table-bordered table-striped">
    <thead class="table-light">
        <tr>
            <th>Ім'я</th>
            <th>Прізвище</th>
            <th>Рік випуску</th>
            <th>Спеціалізація</th>
            <th style="width:200px">Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var graduate in Model)
        {
            <tr>
                <td>@graduate.FirstName</td>
                <td>@graduate.LastName</td>
                <td>@graduate.GraduationYear</td>
                <td>@graduate.Specialization</td>
                <td class="d-flex align-items-center gap-2">
                    <button class="btn btn-primary btn-sm"
                            onclick="loadContent('EditGraduate', '/@graduate.Id')">
                        Редагувати
                    </button>
                    <form method="post"
                          asp-action="DeleteGraduate"
                          asp-route-id="@graduate.Id"
                          onsubmit="return confirm('Видалити випускника?') && submitForm(this)"
                          style="margin: 0;">
                        <button class="btn btn-danger btn-sm">Видалити</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>