@model List<it_department_site.Database.Page>

<a href="/Admin/PageEditor" class="btn btn-success mb-3">Створити нову сторінку</a>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>Title</th>
            <th>Slug</th>
            <th>Status</th>
            <th>Created At</th>
            <th>Updated At</th>
            <th>Дії</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Title</td>
                <td>@item.Slug</td>
                <td>@item.Status</td>
                <td>@item.CreatedAt</td>
                <td>@item.UpdatedAt</td>
                <td>
                    <a href="/Admin/PageEditor?id=@item.Id" class="btn btn-sm btn-primary">Редагувати</a>
                </td>
            </tr>
        }
    </tbody>
</table>
