@inject it_department_site.Services.ISiteSettingsService SettingsService
@{
    Layout = null;
    var siteSettings = SettingsService.Get();
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Реєстрація</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />

    @if (!string.IsNullOrEmpty(siteSettings?.SelectedTheme) && siteSettings.SelectedTheme != "default")
    {
        <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootswatch@5.3.0/dist/@(siteSettings.SelectedTheme)/bootstrap.min.css" />
    }

    <style>
        body, html {
            height: 100%;
            margin: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            background-color: #f8f9fa;
        }

        .register-box {
            background: white;
            padding: 30px;
            border-radius: 8px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.1);
            width: 100%;
            max-width: 400px;
        }
    </style>
</head>
<body>
    <div class="register-box">
        <h2 class="text-center mb-4">Реєстрація</h2>
        <form method="post">
            <div class="mb-3">
                <label for="username" class="form-label">Ім’я користувача</label>
                <input type="text" class="form-control" id="username" name="username" required />
            </div>
            <div class="mb-3">
                <label for="email" class="form-label">Email</label>
                <input type="email" class="form-control" id="email" name="email" required />
            </div>
            <div class="mb-3">
                <label for="password" class="form-label">Пароль</label>
                <input type="password" class="form-control" id="password" name="password" required />
            </div>
            <button type="submit" class="btn btn-primary w-100">Зареєструватись</button>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">@ViewBag.Error</div>
            }
        </form>
    </div>
</body>
</html>
