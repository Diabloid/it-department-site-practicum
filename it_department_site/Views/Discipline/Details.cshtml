@model it_department_site.Entities.Discipline
@{
    ViewData["Title"] = Model.Name;
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new("Дисципліни", Url.Action("Index", "Disciplines")),
        new(Model.Name)
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/disciplines.css" asp-append-version="true" />
}
<article class="content">
    @await Html.PartialAsync("Partials/_Breadcrumbs", ViewData["Breadcrumbs"])

    <section class="discipline-details-page">
        <header class="discipline-header">
            <h1 class="discipline-header-title">@Model.Name</h1>
        </header>

        <article class="discipline-article">

            @if (!string.IsNullOrWhiteSpace(Model.Description))
            {
                <div class="discipline-description">@Html.Raw(Model.Description)</div>
            }
            else
            {
                <div class="discipline-description text-muted">Опис ще не додано.</div>
            }
        </article>

        <a asp-controller="Disciplines" asp-action="Index" class="discipline-back">
            ← Назад до дисциплін
        </a>
    </section>
</article>
