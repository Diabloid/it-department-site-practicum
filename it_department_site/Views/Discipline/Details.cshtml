@model it_department_site.Entities.Discipline
@{
    ViewData["Title"] = Model.Name;
}
@section Styles {
    <link rel="stylesheet" href="~/css/disciplines.css" asp-append-version="true" />
}

<section class="discipline-details-page">
    <nav class="discipline-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Pages" asp-action="Index">Головна</a>
        <span aria-hidden="true">/</span>
        <a asp-controller="Disciplines" asp-action="Index">Дисципліни</a>
        <span aria-hidden="true">/</span>
        <span class="discipline-breadcrumb-current">@Model.Name</span>
    </nav>

    <header class="discipline-header">
        <h1 class="discipline-header-title">@Model.Name</h1>
    </header>

    <article class="discipline-article">
@*         <div class="discipline-teacher">
            <span class="discipline-teacher-label">Викладач:</span>
            <span>@Model.Teacher</span>
        </div> *@

        @if (!string.IsNullOrWhiteSpace(Model.Description))
        {
            <div class="discipline-description">@Model.Description</div>
        }
        else
        {
            <div class="discipline-description text-muted">Опис ще не додано.</div>
        }
    </article>

    <a asp-controller="Disciplines" asp-action="Index" class="discipline-back">
        ← Назад до дисциплін
    </a>
</section>
