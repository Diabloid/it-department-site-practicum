@model IEnumerable<it_department_site.Entities.Discipline>
@{
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new(ViewData["Title"].ToString())
    };

    var currentPage = ViewData["CurrentPage"] as int? ?? 1;
    var totalPages = ViewData["TotalPages"] as int? ?? 0;
    var searchName = ViewData["SearchName"] as string ?? "";
    var requiredQuery = (Context.Request.Query["required"].FirstOrDefault() ?? "").Trim();
    var isRequiredFromView = ViewData["IsRequired"] is bool requiredFlag && requiredFlag;
    var isRequired = requiredQuery.Equals("true", StringComparison.OrdinalIgnoreCase)
        || requiredQuery == "1"
        || isRequiredFromView;
    var hasSearch = !string.IsNullOrWhiteSpace(searchName);

    string PagerUrl(int page)
    {
        var query = new List<string>
        {
            $"required={(isRequired ? "true" : "false")}",
            $"pageNumber={page}"
        };
        if (hasSearch)
        {
            query.Add($"name={Uri.EscapeDataString(searchName)}");
        }

        return "/disciplines?" + string.Join("&", query);
    }
}
@section Styles {
    <link rel="stylesheet" href="~/css/disciplines.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}
<article class="content">
    @await Html.PartialAsync("Partials/_Breadcrumbs", ViewData["Breadcrumbs"])

    <section class="disciplines-page">

        <header class="employees-hero" aria-labelledby="employees-page-title">
            <div class="employees-hero-glow employees-hero-glow--left" aria-hidden="true"></div>
            <div class="employees-hero-glow employees-hero-glow--right" aria-hidden="true"></div>

            <div class="employees-hero-inner">
                <h1 id="employees-page-title" class="employees-title-main">
                    <span class="employees-title-line">@ViewData["Title"]</span>
                    <span class="employees-title-accent">спеціальності</span>
                </h1>

                <p class="employees-subtitle">
                    Перелік навчальних дисциплін спеціальності "Інженерія програмного забезпечення"
                </p>

                <div class="employees-hero-divider" aria-hidden="true">
                    <span class="employees-hero-divider-line"></span>

                    <span class="employees-hero-divider-line"></span>
                </div>
            </div>
        </header>

        <form class="disciplines-search" role="search" action="/disciplines" method="get">
            <input type="hidden" name="required" value="@(isRequired ? "true" : "false")" />
            <label class="visually-hidden" for="disciplines-search-input">Пошук дисципліни</label>
            <input id="disciplines-search-input"
                   class="disciplines-search-input"
                   type="search"
                   name="name"
                   value="@searchName"
                   placeholder="Пошук дисципліни…"
                   maxlength="50"
                   autocomplete="off" />
        </form>

        @if (!Model.Any())
        {
            <div class="disciplines-empty">
                @(hasSearch ? "Нічого не знайдено." : "Дисципліни ще не додано.")
            </div>
        }
        else
        {
            <div class="disciplines-grid">
                @foreach (var discipline in Model)
                {
                    <article class="discipline-card">
                        <a asp-controller="Disciplines"
                           asp-action="Details"
                           asp-route-id="@discipline.Id"
                           class="discipline-card-link">
                            <h2 class="discipline-card-name">@discipline.Name</h2>
                        </a>
                    </article>
                }
            </div>
        }

        @if (totalPages > 1)
        {
            <nav class="disciplines-pager" aria-label="Пагінація дисциплін">
                @if (currentPage <= 1)
                {
                    <span class="disciplines-pager-btn disciplines-pager-prev is-disabled" aria-disabled="true">&lt;</span>
                }
                else
                {
                    <a class="disciplines-pager-btn disciplines-pager-prev"
                       href="@PagerUrl(currentPage - 1)"
                       aria-label="Попередня сторінка">&lt;</a>
                }

                @for (var i = 1; i <= totalPages; i++)
                {
                    if (i == currentPage)
                    {
                        <span class="disciplines-pager-btn is-active" aria-current="page">@i</span>
                    }
                    else
                    {
                        <a class="disciplines-pager-btn"
                           href="@PagerUrl(i)"
                           aria-label="Сторінка @i">@i</a>
                    }
                }

                @if (currentPage >= totalPages)
                {
                    <span class="disciplines-pager-btn disciplines-pager-next is-disabled" aria-disabled="true">&gt;</span>
                }
                else
                {
                    <a class="disciplines-pager-btn disciplines-pager-next"
                       href="@PagerUrl(currentPage + 1)"
                       aria-label="Наступна сторінка">&gt;</a>
                }
            </nav>
        }
    </section>
</article>

@section Scripts {
    <script src="~/js/disciplines-list.js" asp-append-version="true"></script>
}
