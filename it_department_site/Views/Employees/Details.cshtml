@model it_department_site.ViewModels.EmployeeInfoViewModel
@{
    var employeeName = $"{Model.LastName} {Model.FirstName} {Model.PatronymicName}".Trim();
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new("Співробітники", "/Employees"),
        new(employeeName)
    };
    ViewData["Title"] = employeeName;
}

@section Styles {
    <link rel="stylesheet" href="~/css/disciplines.css" asp-append-version="true" />
    <script src="~/js/disciplines.js"></script>
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}
<article class="content">
    @await Html.PartialAsync("Partials/_Breadcrumbs", ViewData["Breadcrumbs"])

    <article class="discipline-article">
        <header class="discipline-header">
            <div class="employee-header-inner">
                <div class="avatar">
                    <img src="@(string.IsNullOrEmpty(Model.PhotoUrl) ? DefaultImages.Avatar : Model.PhotoUrl)"
                         alt="@Model.LastName @Model.FirstName @Model.PatronymicName"
                         class="employee-profile-photo" />
                </div>
                <div class="employee-header-text">
                    <h1 class="discipline-header-title">@employeeName</h1>
                    @if (!string.IsNullOrWhiteSpace(Model.Email))
                    {
                        <a href="mailto:@Model.Email" class="employee-header-email">@Model.Email</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(Model.Specialization))
                    {
                        <p class="employee-header-meta">@Model.Specialization</p>
                    }
                </div>
            </div>
        </header>

        <div class="tabs-container" role="tablist">
            <div class="tab-menu">
                <button class="tab-btn active" data-tab="info" role="tab">Інформація</button>
                <button class="tab-btn" data-tab="disciplines" role="tab">Дисципліни</button>
                <button class="tab-btn" data-tab="certificates" role="tab">Сертифікати</button>
            </div>

            <div class="tab-panels">
                <div id="info" class="tab-panel active">
                    @if (!string.IsNullOrWhiteSpace(Model.Bio))
                    {
                        var infoHtml = Model.Bio.Contains("&lt;")
                            ? System.Net.WebUtility.HtmlDecode(Model.Bio)
                            : Model.Bio;
                        <div class="employee-bio">
                            @Html.Raw(infoHtml)
                        </div>
                    }
                    else
                    {
                        <div class="discipline-description text-muted">Опис ще не додано.</div>
                    }
                </div>
                <div id="disciplines" class="tab-panel">
                    <div class="resources-container">
                        @foreach (var discipline in Model.Disciplines)
                        {
                            <a class="card-container"
                               asp-controller="disciplines"
                               asp-route-id="@discipline.Id">
                                <span class="link-title">@discipline.Name</span>
                                <span class="chevron">›</span>
                            </a>
                        }
                    </div>
                </div>
                <div id="certificates" class="tab-panel">
                    <div class="resources-container" id="employee-certificates">
                        @if (Model.Certificates.Count > 0)
                        {
                            <div class="certificates-section">
                                <div class="certificates-slider-wrap">
                                    <div class="certificates-mask-wrapper">
                                        <div class="certificates-track">
                                            @foreach (var t in Model.Certificates)
                                            {
                                                @await Html.PartialAsync("_CertificateDisplay", t)
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <p class="discipline-description text-muted mb-0">Сертифікати ще не додано.</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    </article>
</article>
