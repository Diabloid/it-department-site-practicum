@model it_department_site.ViewModels.EmployeeInfoViewModel
@{
    var fullName = $"{Model.LastName} {Model.FirstName} {Model.PatronymicName}".Trim();
    ViewData["Title"] = fullName;
    var photoUrl = string.IsNullOrEmpty(Model.PhotoUrl) ? "/images/default/avatar.jpg" : Model.PhotoUrl;
}

@section Styles {
    <link rel="stylesheet" href="~/css/disciplines.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/employees.css" asp-append-version="true" />
}

<section class="discipline-details-page employee-details-page">
    <nav class="discipline-breadcrumb" aria-label="Breadcrumb">
        <a asp-controller="Pages" asp-action="Index">Головна</a>
        <span aria-hidden="true">/</span>
        <a asp-controller="Employees" asp-action="Index">Співробітники</a>
        <span aria-hidden="true">/</span>
        <span class="discipline-breadcrumb-current">@fullName</span>
    </nav>

    <header class="discipline-header employee-header">
        <div class="employee-header-inner">
            <div class="employee-header-photo-wrap">
                <img src="@photoUrl"
                     alt="@fullName"
                     class="employee-header-photo" />
            </div>
            <div class="employee-header-text">
                <h1 class="discipline-header-title">@fullName</h1>
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <a href="mailto:@Model.Email" class="employee-header-email">@Model.Email</a>
                }
                @if (!string.IsNullOrWhiteSpace(Model.Specialization))
                {
                    <p class="employee-header-meta">@Model.Specialization</p>
                }
            </div>
        </div>
    </header>

    <ul class="employee-tablist nav" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="employee-tab active"
                    id="employee-info-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#employee-info"
                    type="button"
                    role="tab"
                    aria-controls="employee-info"
                    aria-selected="true">
                Інформація
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="employee-tab"
                    id="employee-disciplines-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#employee-disciplines"
                    type="button"
                    role="tab"
                    aria-controls="employee-disciplines"
                    aria-selected="false">
                Дисципліни
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="employee-tab"
                    id="employee-certificates-tab"
                    data-bs-toggle="tab"
                    data-bs-target="#employee-certificates"
                    type="button"
                    role="tab"
                    aria-controls="employee-certificates"
                    aria-selected="false">
                Сертифікати
            </button>
        </li>
    </ul>

    <article class="discipline-article">
        <div class="tab-content">
            <div class="tab-pane show active"
                 id="employee-info"
                 role="tabpanel"
                 aria-labelledby="employee-info-tab"
                 tabindex="0">
                @if (!string.IsNullOrWhiteSpace(Model.Bio))
                {
                    var infoHtml = Model.Bio.Contains("&lt;")
                        ? System.Net.WebUtility.HtmlDecode(Model.Bio)
                        : Model.Bio;
                    <div class="employee-bio">
                        @Html.Raw(infoHtml)
                    </div>
                }
                else
                {
                    <p class="text-muted mb-0">Інформацію ще не додано.</p>
                }
            </div>

            <div class="tab-pane fade"
                 id="employee-disciplines"
                 role="tabpanel"
                 aria-labelledby="employee-disciplines-tab"
                 tabindex="0">
                @if (Model.Disciplines != null && Model.Disciplines.Count > 0)
                {
                    <div class="employee-disciplines-list">
                        @foreach (var discipline in Model.Disciplines.OrderBy(d => d.SortOrder))
                        {
                            <a asp-controller="Disciplines"
                               asp-action="Details"
                               asp-route-id="@discipline.Id"
                               class="discipline-link">
                                @discipline.Name
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="discipline-description text-muted mb-0">Дисципліни ще не призначені.</p>
                }
            </div>

            <div class="tab-pane fade"
                 id="employee-certificates"
                 role="tabpanel"
                 aria-labelledby="employee-certificates-tab"
                 tabindex="0">
                @if (Model.Certificates.Count > 0)
                {
                    <div class="certificates-section">
                        <div class="certificates-slider-wrap">
                            <div class="certificates-mask-wrapper">
                                <div class="certificates-track">
                                    @for (var i = 0; i < Model.Certificates.Count; i++)
                                    {
                                        @await Html.PartialAsync("_CertificateDisplay", Model.Certificates[i])
                                    }

                                    @if (Model.Certificates.Count > 1)
                                    {
                                        @for (var i = 0; i < Model.Certificates.Count; i++)
                                        {
                                            @await Html.PartialAsync("_CertificateDisplay", Model.Certificates[i])
                                        }
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
                else
                {
                    <p class="discipline-description text-muted mb-0">Сертифікати ще не додано.</p>
                }
            </div>
        </div>
    </article>
</section>
