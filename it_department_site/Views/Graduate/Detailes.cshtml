@model it_department_site.Entities.Graduate
@{
    ViewData["Title"] = $"{Model.FirstName} {Model.LastName}";
}
@section Styles {
    <link rel="stylesheet" href="~/css/graduates.css" asp-append-version="true" />
}
<section class="graduate-details container py-5">
    <a asp-controller="Graduates" asp-action="Index" class="btn btn-outline-secondary mb-4">← Назад</a>

    <div class="graduate-details-card">
        <div class="graduate-details-photo-wrap">
            @if (!string.IsNullOrEmpty(Model.PhotoUrl))
            {
                <img src="@Model.PhotoUrl" alt="@Model.LastName" class="graduate-details-photo" />
            }
            else
            {
                <div class="graduate-photo-placeholder">👤</div>
            }
        </div>

        <div class="graduate-details-body">
            <h1 class="graduate-details-name">@Model.FirstName @Model.LastName</h1>
            <p class="graduate-details-year">Рік випуску: <strong>@Model.GraduationYear</strong></p>
            <p class="graduate-details-specialization">@Model.Specialization</p>

            @if (!string.IsNullOrEmpty(Model.JobDescription))
            {
                <div class="graduate-details-job">
                    <h3>Де працює</h3>
                    <p>@Model.JobDescription</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(Model.Testimonial))
            {
                <div class="graduate-details-testimonial">
                    <h3>Відгук</h3>
                    <blockquote>@Model.Testimonial</blockquote>
                </div>
            }
        </div>
    </div>
</section>