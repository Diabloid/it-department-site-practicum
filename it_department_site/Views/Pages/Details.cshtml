@model it_department_site.DTOs.PageDto
@using System.Security.Claims

@{
    bool isAdmin = false;
    int userId = 0;

    
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="w-100 px-4">
    <div class="card shadow-sm mb-4 w-100">
        <h3 class="card-header">@Model.Title</h3>

        <div class="card-body p-4">
            <p class="card-subtitle text-muted mb-2">
                Створено: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </p>

            <div class="d-flex align-items-center gap-2 mt-2 mb-3">
                @if ( !isAdmin)
                {
                    <button type="button"
                            data-page-id="@Model.Id">
                    </button>
                }

                <button type="button"
                        id="like-btn"
                        class="btn btn-outline-success btn-sm d-flex align-items-center gap-1"
                        data-page-id="@Model.Id">
                    ❤️ <span id="like-count">@ViewBag.Likes</span>
                </button>

                <div class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" style="cursor: default;">
                    👁 <span>@ViewBag.Views</span>
                </div>
            </div>
            <hr />
            @if (Model.LayoutType == "left-sidebar")
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="sidebar bg-light p-3 rounded">
                            @Html.Raw(Model.LeftSidebar)
                        </div>
                    </div>
                    <div class="col-md-9">
                        @Html.Raw(Model.MainContent)
                    </div>
                </div>
            }
            else if (Model.LayoutType == "right-sidebar")
            {
                <div class="row">
                    <div class="col-md-9">
                        @Html.Raw(Model.MainContent)
                    </div>
                    <div class="col-md-3">
                        <div class="sidebar bg-light p-3 rounded">
                            @Html.Raw(Model.RightSidebar)
                        </div>
                    </div>
                </div>
            }
            else
            {
                @Html.Raw(Model.MainContent)
            }
        </div>

        
    </div>
</div>

<script src="~/ckeditor/ckeditor.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', () => {
        const likeBtn = document.getElementById("like-btn");
        if (likeBtn) {
            likeBtn.addEventListener("click", () => {
                const pageId = likeBtn.dataset.pageId;
                fetch("/likes/toggle", {
                    method: "POST",
                    headers: { "Content-Type": "application/x-www-form-urlencoded" },
                    body: `pageId=${pageId}`
                })
                .then(res => res.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById("like-count").textContent = data.likeCount;
                    }
                });
            });
        }
    });
</script>
