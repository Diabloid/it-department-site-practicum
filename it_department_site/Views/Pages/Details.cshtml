@model it_department_site.DTOs.PageDto

@{
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
    var viewsCount = ViewBag.Views as int? ?? Model.ViewsCount;
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new(Model.Title)
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/page-details.css" asp-append-version="true" />
}

<div class="page-details">
    <div class="page-shell">
        <header class="page-header">
            <h1 class="page-title">@Model.Title</h1>
        </header>

        <div class="page-body">
            <article class="page-article">
                <div class="page-meta-row page-meta-row--article">
                    <span class="page-meta-item">
                        <img src="~/images/icons/eye.svg" alt="" class="page-meta-icon" aria-hidden="true" />
                        <span>@viewsCount переглядів</span>
                    </span>
                    <span class="page-meta-dot" aria-hidden="true"></span>
                    <span class="page-meta-item">
                        <img src="~/images/icons/calendar.svg" alt="" class="page-meta-icon" aria-hidden="true" />
                        <time datetime="@Model.CreatedAt.ToString("yyyy-MM-dd")">
                            @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
                        </time>
                    </span>
                </div>

                @if (Model.LayoutType == "left-sidebar")
                {
                    <div class="page-layout">
                        <aside class="page-sidebar">
                            <span class="page-sidebar-label">Додатково</span>
                            <div class="page-prose">
                                @Html.Raw(Model.LeftSidebar)
                            </div>
                        </aside>
                        <div class="page-prose page-prose--full">
                            @Html.Raw(Model.MainContent)
                        </div>
                    </div>
                }
                else if (Model.LayoutType == "right-sidebar")
                {
                    <div class="page-layout page-layout--right">
                        <div class="page-prose page-prose--full">
                            @Html.Raw(Model.MainContent)
                        </div>
                        <aside class="page-sidebar">
                            <span class="page-sidebar-label">Додатково</span>
                            <div class="page-prose">
                                @Html.Raw(Model.RightSidebar)
                            </div>
                        </aside>
                    </div>
                }
                else
                {
                    <div class="page-prose">
                        @Html.Raw(Model.MainContent)
                    </div>
                }
            </article>

            <a href="/" class="page-back-link">← На головну</a>
        </div>
    </div>
</div>
