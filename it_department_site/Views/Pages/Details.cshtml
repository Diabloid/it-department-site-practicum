@model it_department_site.DTOs.PageDto
@using System.Security.Claims
@inject IFavoriteService FavoriteService

@{
    bool showFavoriteButton = false;
    bool isAdmin = false;
    int userId = 0;

    
    ViewData["Title"] = Model.Title;
    Layout = "_Layout";
}

<div class="w-100 px-4">
    <div class="card shadow-sm mb-4 w-100">
        <h3 class="card-header">@Model.Title</h3>

        <div class="card-body p-4">
            <p class="card-subtitle text-muted mb-2">
                Створено: @Model.CreatedAt.ToString("dd.MM.yyyy HH:mm")
            </p>

            <div class="d-flex align-items-center gap-2 mt-2 mb-3">
                @if ( !isAdmin)
                {
                    <button type="button"
                            id="favorite-btn"
                            class="btn btn-sm @(showFavoriteButton ? "btn-outline-danger" : "btn-outline-success")"
                            data-page-id="@Model.Id">
                        @(showFavoriteButton ? "🔖" : "✅")
                    </button>
                }

                <div class="btn btn-outline-primary btn-sm d-flex align-items-center gap-1" style="cursor: default;">
                    👁 <span>@ViewBag.Views</span>
                </div>
            </div>
            <hr />
            @if (Model.LayoutType == "left-sidebar")
            {
                <div class="row">
                    <div class="col-md-3">
                        <div class="sidebar bg-light p-3 rounded">
                            @Html.Raw(Model.LeftSidebar)
                        </div>
                    </div>
                    <div class="col-md-9">
                        @Html.Raw(Model.MainContent)
                    </div>
                </div>
            }
            else if (Model.LayoutType == "right-sidebar")
            {
                <div class="row">
                    <div class="col-md-9">
                        @Html.Raw(Model.MainContent)
                    </div>
                    <div class="col-md-3">
                        <div class="sidebar bg-light p-3 rounded">
                            @Html.Raw(Model.RightSidebar)
                        </div>
                    </div>
                </div>
            }
            else
            {
                @Html.Raw(Model.MainContent)
            }
        </div>

        
    </div>
</div>

<script src="~/ckeditor/ckeditor.js"></script>
<script>
        const favBtn = document.getElementById("favorite-btn");
        favBtn?.addEventListener("click", () => {
            const pageId = favBtn.dataset.pageId;
            const isFavorite = favBtn.classList.contains("btn-outline-danger");
            fetch("/favorites/toggle", {
                method: "POST",
                headers: { "Content-Type": "application/x-www-form-urlencoded" },
                body: `pageId=${pageId}`
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    const nowFavorite = !isFavorite;
                    favBtn.innerHTML = nowFavorite ? "🔖" : "✅";
                    favBtn.classList.toggle("btn-outline-danger", nowFavorite);
                    favBtn.classList.toggle("btn-outline-success", !nowFavorite);
                }
            });
    });
</script>
