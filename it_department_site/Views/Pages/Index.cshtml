@using it_department_site.Entities
@{
    ViewData["Title"] = "Головна";
    
    // Отримуємо дані з ViewBag та конвертуємо у список
    var newsList = (ViewBag.News as IEnumerable<Post>)?.ToList() ?? new List<Post>();
}

<div class="main-content">

    <div class="start-banner">
        <div class="banner-container">
            <div class="banner-element">
                <img class="banner_image" src="~/images/banner_photo_1.JPG" alt="Banner Image" />
            </div>
        </div>
    </div>

    <div class="content-part-line">
        <div class="content-part">

            <div class="ourlife-and-news">
                
                <div class="ourlife-area">
                    <div class="ourlife-square">
                        <div class="text-field">
                            <h2>OUR LIFE</h2>
                            <p>Студентське життя сповнене подій та емоцій.</p>
                        </div>
                        <div class="image-field">
                            <img src="~/images/image 7.png" alt="Our Life Image" />
                        </div>
                    </div>
                </div>

                <div class="news-area">
                    <div class="news-content-and-title">
                        <div class="news-general-title">
                            <h2>News</h2>
                        </div>

                        <div class="news-content">
                            @if (newsList.Any())
                            {
                                var mainPost = newsList.First();
                                var sidePosts = newsList.Skip(1).Take(3).ToList();

                                <div class="news-grid-container" style="display: flex; gap: 20px; flex-wrap: wrap;">
                                    
                                    <div class="main-news-block" style="flex: 2; min-width: 300px;">
                                        <a href="/Posts/Details/@mainPost.Id" style="text-decoration:none; color:inherit;">
                                            <div class="news-image" style="background-image:url('@(string.IsNullOrEmpty(mainPost.Thumbnail) ? "/images/default-news.jpg" : mainPost.Thumbnail)'); background-size:cover; background-position:center; height: 300px; border-radius: 15px;"></div>
                                            <div class="news-date" style="margin-top: 10px;"><p>@mainPost.CreatedAt.ToString("dd.MM.yyyy")</p></div>
                                            <h3 style="margin-top: 5px;">@mainPost.Title</h3>
                                            <p style="font-size: 0.9em; color: #555;">@mainPost.Excerpt</p>
                                        </a>
                                    </div>

                                    <div class="side-news-list" style="flex: 1; display: flex; flex-direction: column; gap: 15px; min-width: 250px;">
                                        @foreach (var item in sidePosts)
                                        {
                                            <a href="/Posts/Details/@item.Id" style="text-decoration:none; color:inherit; display: flex; gap: 10px; align-items: center;">
                                                <div style="background-image:url('@(string.IsNullOrEmpty(item.Thumbnail) ? "/images/default-news.jpg" : item.Thumbnail)'); background-size:cover; background-position:center; width: 80px; height: 80px; border-radius: 10px; flex-shrink:0;"></div>
                                                <div>
                                                    <small style="color: #888;">@item.CreatedAt.ToString("dd.MM.yyyy")</small>
                                                    <div style="font-weight: bold; font-size: 0.9em; line-height: 1.2;">@item.Title</div>
                                                </div>
                                            </a>
                                        }
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div style="text-align:center; padding: 30px; border: 1px dashed #ccc; border-radius: 15px;">
                                    <p style="color:#999;">Новин поки немає (Перевірте базу даних та мапінг у Program.cs)</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="reviews-area">
                <div class="reviews-field">
                    <div class="reviews-general-title">
                        <h2>Reviews</h2>
                    </div>

                    <div class="reviews-content">
                        <div class="pfp-name-status">
                            <div class="profile-picture">
                                <img src="~/images/pfp1.jpg" alt="Student" style="width:100%; height:100%; object-fit:cover; border-radius:50%;" />
                            </div>
                            <div class="name-and-status">
                                <h3>Олександр Петренко</h3>
                                <p>Student</p>
                            </div>
                        </div>

                        <div class="rating-stars" style="margin: 10px 0;">
                            <svg width="130" height="24" viewBox="0 0 130 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M10.6 4.7C11.1 3.2 13.2 3.2 13.7 4.7L14.5 7.1C14.7 7.8 15.4 8.2 16.1 8.2H18.6C20.2 8.2 20.9 10.3 19.6 11.2L17.6 12.7C17 13.1 16.7 13.8 17 14.5L17.7 16.9C18.2 18.4 16.5 19.7 15.2 18.7L13.1 17.2C12.6 16.8 11.8 16.8 11.2 17.2L9.1 18.7C7.8 19.7 6.1 18.4 6.6 16.9L7.3 14.5C7.6 13.8 7.3 13.1 6.7 12.7L4.7 11.2C3.4 10.3 4.1 8.2 5.7 8.2H8.2C8.9 8.2 9.6 7.8 9.8 7.1L10.6 4.7Z" fill="#FFC353"/>
                                </svg>
                        </div>

                        <div class="comments">
                            <p><b>Чудове місце!</b> Якісна освіта, сучасні підходи та дружній колектив. Рекомендую!</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="partners-area">
                <div class="partners-general-title">
                    <h2>Our Partners</h2>
                </div>

<div class="partners-area">
                <div class="partners-general-title">
                    <h2>Our Partners</h2>
                </div>

                <div class="partners-mask-wrapper">
                    <div class="partners-track">
                        @if (ViewBag.Partners != null)
                        {
                            var partners = (List<string>)ViewBag.Partners;
                            foreach (var imgUrl in partners)
                            {
                                <div class="partner-logo">
                                    <img src="@imgUrl" alt="Partner" />
                                </div>
                            }

                            @* Дублювання для нескінченної анімації, якщо партнерів багато *@
                            if (partners.Count > 3)
                            {
                                foreach (var imgUrl in partners)
                                {
                                    <div class="partner-logo">
                                        <img src="@imgUrl" alt="Partner" />
                                    </div>
                                }
                            }
                        }
                        else
                        {
                            <p style="text-align:center; width:100%; color:#999;">Партнерів поки немає</p>
                        }
                    </div>
                </div>
            </div>
                </div>
            </div>

        </div>
    </div>
</div>