@{
   ViewData["Title"] = "Головна";
   var newsList = (ViewBag.News as IEnumerable<Post>)?.ToList() ?? new List<Post>();
   var mainSliderSlides = (ViewBag.MainSliderSlides as IEnumerable<MainSliderSlide>)?.ToList()
       ?? new List<MainSliderSlide>();

   var reviewsList = (ViewBag.Reviews as IEnumerable<it_department_site.Entities.Graduate>)?.ToList()
       ?? new List<it_department_site.Entities.Graduate>();
}

@if (mainSliderSlides.Any())
{
    <div class="start-banner">
        @await Html.PartialAsync("Partials/_MainBannerSlider", mainSliderSlides)
    </div>
}
<div class="main-content">
            <div class="ourlife-and-news">

                <a class="ourlife-area" asp-controller="Post" asp-action="Index" asp-route-category="our-life">
                    <div class="ourlife-square">
                        <div class="text-field">
                            <h2>НАШЕ ЖИТТЯ</h2>
                            <p>Студентське життя сповнене подій та емоцій. Тут ми ділимося найяскравішими моментами нашого навчання та відпочинку.</p>
                        </div>
                        <div class="image-field">
                        </div>
                    </div>
                </a>

                <div class="news-area">
                    <div class="news-content-and-title">
                        <div class="news-general-title">
                            <h2>Новини</h2>
                        </div>
                        <div class="news-content">
                            @if (newsList.Any())
                            {
                                var mainPost = newsList.First();
                                var sidePosts = newsList.Skip(1).Take(3).ToList();

                                <div class="main-news-block">
                                    <a href="/posts/@(mainPost.Slug)">
                                       <div class="news-image" style="background-image:url('@(string.IsNullOrEmpty(mainPost.Thumbnail) ? DefaultImages.News : mainPost.Thumbnail)');"></div>
                                        <span class="news-date">
                                            <img class="news-date-icon" src="~/images/icons/calendar.svg" alt="calendar" />
                                            @((mainPost.PublishedAt ?? mainPost.CreatedAt).ToString("dd.MM.yyyy"))
                                        </span>
                                        <h3>@mainPost.Title</h3>
                                        <div class="news-excerpt">@Html.Raw(mainPost.Excerpt)</div>
                                    </a>
                                </div>

                                <div class="side-news-list">
                                    @foreach (var item in sidePosts)
                                    {
                                        <a href="/posts/@(item.Slug)">
                                            <div class="news-image-small" style="background-image:url('@(string.IsNullOrEmpty(item.Thumbnail) ? DefaultImages.News : item.Thumbnail)');"></div>
                                            <div class="news-info-container">
                                                <small>
                                                    <div class="news-meta" >
                                                        <img class="news-date-icon" src="~/images/icons/calendar.svg" alt="calendar" />
                                                        @((item.PublishedAt ?? item.CreatedAt).ToString("dd.MM.yyyy"))
                                                    </div>
                                                  
                                                </small>
                                                <div class="news-title-wrapper">
                                                    <div class="news-title-small">@item.Title</div>
                                                </div>
                                            </div>
                                        </a>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>
</div>
@await Html.PartialAsync("Partials/_Reviews", reviewsList)
@await Html.PartialAsync("Partials/_PartnerSlider", (List<Partner>)(ViewBag.Partners ?? new List<Partner>()))
