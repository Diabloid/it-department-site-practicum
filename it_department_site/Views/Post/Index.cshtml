@model IEnumerable<it_department_site.Entities.Post>

@{
    ViewData["Title"] = "Новини";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new("Усі новини")
    };
}

@section Styles {
    <link rel="stylesheet" href="~/css/posts.css" asp-append-version="true" />
}

<article class="content">
    @await Html.PartialAsync("Partials/_Breadcrumbs", ViewData["Breadcrumbs"])

    <section class="posts-page">
        <header class="posts-hero" aria-labelledby="posts-page-title">
            <div class="posts-hero-glow posts-hero-glow--left" aria-hidden="true"></div>
            <div class="posts-hero-glow posts-hero-glow--right" aria-hidden="true"></div>

            <div class="posts-hero-inner">

                <h1 id="posts-page-title" class="posts-title-main">
                    <span class="posts-title-line">Новини</span>
                    <span class="posts-title-accent">спеціальності</span>
                </h1>

                <p class="posts-subtitle">
                    Події, оголошення та життя спеціальності інженерії програмного забезпечення.
                </p>

                <div class="posts-hero-divider" aria-hidden="true">
                    <span class="posts-hero-divider-line"></span>
                    <span class="posts-hero-divider-line"></span>
                </div>
            </div>
        </header>

        @if (!Model.Any())
        {
            <div class="posts-empty">Новин ще немає.</div>
        }
        else
        {
            <div class="posts-grid">
                @foreach (var post in Model)
                {
                    var thumb = string.IsNullOrWhiteSpace(post.Thumbnail)
                        ? DefaultImages.News
                        : post.Thumbnail;
                    var postedAt = post.PublishedAt ?? post.CreatedAt;
                    <article class="posts-card">
                        <a href="/posts/@post.Slug" class="posts-card-link">
                            <div class="posts-card-image" style="background-image:url('@thumb');"></div>
                            <div class="posts-card-body">
                                <span class="posts-card-date">
                                    <img class="posts-card-date-icon" src="~/images/icons/calendar.svg" alt="" />
                                    <time datetime="@postedAt.ToString("yyyy-MM-dd")">@postedAt.ToString("dd.MM.yyyy")</time>
                                </span>
                                <h2 class="posts-card-title">@post.Title</h2>
                                @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                                {
                                    <div class="posts-card-excerpt">@Html.Raw(post.Excerpt)</div>
                                }
                            </div>
                        </a>
                    </article>
                }
            </div>
        }
    </section>
</article>
