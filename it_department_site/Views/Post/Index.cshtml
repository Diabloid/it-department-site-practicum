@model IEnumerable<it_department_site.Entities.Post>

@{
    ViewData["Title"] = "Усі новини";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new("Усі новини")
    };
}
<article class="content">
    @await Html.PartialAsync("Partials/_Breadcrumbs", ViewData["Breadcrumbs"])

    <div class="container mt-4">
        <h1 class="mb-4">Усі новини</h1>

        <div class="row">
            @foreach (var post in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm">
                       <img src="@(string.IsNullOrEmpty(post.Thumbnail) ? DefaultImages.News : post.Thumbnail)"
                         class="card-img-top"
                         alt="@post.Title"
                         style="height: 220px; object-fit: cover;" />


                        <div class="card-body d-flex flex-column">
                            <small class="text-muted mb-2">
                                @post.CreatedAt.ToString("dd.MM.yyyy")
                            </small>

                            <h5 class="card-title">@post.Title</h5>

                            @if (!string.IsNullOrWhiteSpace(post.Excerpt))
                            {
                                <p class="card-text text-muted">@post.Excerpt</p>
                            }

                            <a asp-controller="Posts"
                               asp-action="Details"
                               asp-route-id="@post.Id"
                               class="btn btn-primary mt-auto">
                                Читати повністю
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</article>
