@model List<it_department_site.Entities.MenuItem>
@using it_department_site.Entities

@functions {
    bool IsDisciplineMenuItem(MenuItem item)
    {
        return item.Name.Contains("дисциплін", StringComparison.OrdinalIgnoreCase)
            || item.Name.Contains("disciplin", StringComparison.OrdinalIgnoreCase);
    }

    string ResolveMenuUrl(MenuItem item)
    {
        if (!string.IsNullOrEmpty(item.PageSlug) &&
            item.PageSlug.Equals("proudofyou", StringComparison.OrdinalIgnoreCase))
        {
            return "/proudofyou";
        }

        var name = item.Name ?? "";
        if (name.Contains("proud", StringComparison.OrdinalIgnoreCase) &&
            name.Contains("you", StringComparison.OrdinalIgnoreCase))
        {
            return "/proudofyou";
        }

        if (!string.IsNullOrEmpty(item.Name) &&
            item.Name.Contains("Співробітники", StringComparison.OrdinalIgnoreCase))
        {
            return "/Employees/Index";
        }

        if (IsDisciplineMenuItem(item))
            return "/Disciplines";
        if (!string.IsNullOrEmpty(item.CustomUrl))
            return item.CustomUrl;
       if (!string.IsNullOrEmpty(item.PageSlug))
            return $"/{item.PageSlug}";

        return "#";
    }
}

@foreach (var item in Model)
{
    if (item.Children.Any())
    {
        <li class="dropdown">
            <a href="@ResolveMenuUrl(item)">@item.Name</a>

            <div class="dropdown-content">
                @foreach (var child in item.Children)
                {
                    <a href="@ResolveMenuUrl(child)">@child.Name</a>
                }
            </div>
        </li>
    }
    else
    {
        <li><a href="@ResolveMenuUrl(item)">@item.Name</a></li>
    }
}
