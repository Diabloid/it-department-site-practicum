@model List<it_department_site.Entities.MenuItem>

@functions {
    string ResolveMenuUrl(MenuItem item)
    {
        if (!string.IsNullOrEmpty(item.Page?.Slug))
        {
            return $"/{item.Page?.Slug}";
        }

        if (!string.IsNullOrEmpty(item.CustomUrl))
        {
            return $"/{item.CustomUrl}";
        }

        return "#";
    }
}

@foreach (var item in Model)
{
    if (item.Children.Any())
    {
        <li class="dropdown">
            <a href="@ResolveMenuUrl(item)">@item.Name</a>

            <div class="dropdown-content">
                @foreach (var child in item.Children)
                {
                    <a href="@ResolveMenuUrl(child)">@child.Name</a>
                }
            </div>
        </li>
    }
    else
    {
        <li><a href="@ResolveMenuUrl(item)">@item.Name</a></li>
    }
}
