@model List<it_department_site.Entities.MenuItem>

@foreach (var item in Model)
{
    if (item.Children.Any())
    {
        <li class="dropdown">
            @{
                var linkUrl = !string.IsNullOrEmpty(item.PageSlug) ? $"/{item.PageSlug}" : "#";
            }

            <a href="@linkUrl">@item.Name</a>

            <div class="dropdown-content">
                @foreach (var child in item.Children)
                {
                    var childUrl = !string.IsNullOrEmpty(child.PageSlug) ? $"/{child.PageSlug}" : "#";
                    <a href="@childUrl">@child.Name</a>
                }
            </div>
        </li>
    }
    else
    {
        if (!string.IsNullOrEmpty(item.PageSlug))
        {
            <li><a href="/@item.PageSlug">@item.Name</a></li>
        }
        else
        {
            <li><a href="#">@item.Name</a></li>
        }
    }
}