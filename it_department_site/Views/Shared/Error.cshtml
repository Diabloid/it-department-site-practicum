@model ErrorViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Помилка";
}
@section Styles {
    <link rel="stylesheet" href="~/css/status-page.css" asp-append-version="true" />
}

<section class="status-page">
    <div class="status-inner">
        <h1 class="status-title">Щось пішло не так</h1>
        <p class="status-text">
            Під час обробки запиту сталася помилка.
            Спробуйте ще раз пізніше або поверніться на головну.
        </p>
        @if (Model?.ShowRequestId == true)
        {
            <p class="status-meta">
                Request ID: <code>@Model.RequestId</code>
            </p>
        }
        <a href="/" class="status-btn">На головну</a>
    </div>
</section>
