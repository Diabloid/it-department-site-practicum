@{
    Layout = "_Layout";
    ViewData["Title"] = "Сторінку не знайдено";
    ViewData["Breadcrumbs"] = new List<BreadcrumbItem>
    {
        new("Головна", "/"),
        new("Сторінку не знайдено")
    };
}
@section Styles {
    <link rel="stylesheet" href="~/css/status-page.css" asp-append-version="true" />
}

<section class="status-page">
    <div class="status-inner">
        <h1 class="status-title">Сторінку не знайдено</h1>
        <p class="status-text">
            На жаль, такої сторінки немає або вона більше недоступна.
            Перевірте адресу або поверніться на головну.
        </p>
        <a href="/" class="status-btn">На головну</a>
    </div>
</section>
