@model IReadOnlyList<BreadcrumbItem>
@if (Model is { Count: > 0 })
{
    <nav class="site-breadcrumb" aria-label="Breadcrumb">
        @for (var i = 0; i < Model.Count; i++)
        {
            var item = Model[i];
            if (i > 0)
            {
                <span class="site-breadcrumb-sep" aria-hidden="true">/</span>
            }

            if (item.Url is not null)
            {
                <a href="@item.Url">@item.Text</a>
            }
            else
            {
                <span class="site-breadcrumb-current">@item.Text</span>
            }
        }
    </nav>
}