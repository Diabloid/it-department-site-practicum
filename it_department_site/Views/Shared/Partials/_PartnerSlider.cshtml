@model List<it_department_site.Entities.Partner>

<div class="partners-area">
    <div class="news-general-title">
        <h2>Наші партнери</h2>
    </div>
    <div class="partners-mask-wrapper">
        <div class="partners-track">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var partner in Model)
                {
                    var partnerUrl = partner?.GetType().GetProperty("Link")?.GetValue(partner)?.ToString();

                    <div class="partner-logo">
                        @if (!string.IsNullOrWhiteSpace(partnerUrl))
                        {
                            <a href="@partnerUrl" target="_blank" rel="noopener noreferrer" title="@partner.Name">
                                <img src="@partner.LogoFileName" alt="@partner.Name" />
                            </a>
                        }
                        else
                        {
                            <img src="@partner.LogoFileName" alt="@partner.Name" />
                        }
                    </div>
                }

                if (Model.Count > 3)
                {
                    foreach (var partner in Model)
                    {
                        var partnerUrl = partner?.GetType().GetProperty("Link")?.GetValue(partner)?.ToString();

                        <div class="partner-logo">
                            @if (!string.IsNullOrWhiteSpace(partnerUrl))
                            {
                                <a href="@partnerUrl" target="_blank" rel="noopener noreferrer" title="@partner.Name">
                                    <img src="@partner.LogoFileName" alt="@partner.Name" />
                                </a>
                            }
                            else
                            {
                                <img src="@partner.LogoFileName" alt="@partner.Name" />
                            }
                        </div>
                    }
                }
            }
            else
            {
                <p class="text-no-partners">Партнерів поки немає</p>
            }
        </div>
    </div>
</div>
