@model List<it_department_site.Entities.Partner>

<div class="partners-area">
    <div class="partners-general-title">
        <h2>Our Partners</h2>
    </div>
    <div class="partners-mask-wrapper">
        <div class="partners-track">
            @if (Model != null && Model.Count > 0)
            {
                foreach (var partner in Model)
                {
                    <div class="partner-logo">
                        <img src="@partner.LogoFileName" alt="@partner.Name" />
                    </div>
                }

                if (Model.Count > 3)
                {
                    foreach (var partner in Model)
                    {
                        <div class="partner-logo">
                            <img src="@partner.LogoFileName" alt="@partner.Name" />
                        </div>
                    }
                }
            }
            else
            {
                <p style="text-align:center; width:100%; color:#999; padding: 20px;">Партнерів поки немає</p>
            }
        </div>
    </div>
</div>
