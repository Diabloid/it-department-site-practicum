<!DOCTYPE html>
@inject it_department_site.Services.Interfaces.ISiteSettingsService SettingsService
@inject it_department_site.Services.Interfaces.ICurrentUserService CurrentUserService
@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web

@functions {
    string RenderHtml(IHtmlContent content)
    {
        using var writer = new StringWriter();
        content.WriteTo(writer, HtmlEncoder.Default);
        return writer.ToString();
    }
}

@{
    var isJwtLoggedIn = Context.Request.Cookies["jwt"] != null;
    var siteSettings = await SettingsService.GetAsync();

    var menuHtml = RenderHtml(await Component.InvokeAsync("Menu"));

    string loginButtonHtml;

    if (CurrentUserService.IsAuthenticated)
    {
        if (CurrentUserService.IsAdmin)
        {
            loginButtonHtml = @"<li><a href='/Admin/Index'>Admin Panel</a></li>";
        }
        else
        {
            loginButtonHtml = @"<li><a href='/profile'>Profile</a></li>";
        }
    }
    else
    {
        loginButtonHtml = @"<li><a href='/Login'>Log In</a></li>";
    }

    var searchHtml = @"
        <li>
            <form id='searchForm' autocomplete='off' style='display:flex; align-items:center; margin:0;'>
                <input type='search' id='searchInput' name='query' placeholder='Search...'
                       style='padding: 8px; border-radius: 5px; border: 1px solid #ccc;' />
                <div id='suggestionsBox' style='position:absolute; top:60px; background:white; width:200px; box-shadow:0 4px 8px rgba(0,0,0,0.1); border-radius:5px; z-index:1001;'></div>
            </form>
        </li>";
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(siteSettings?.SiteTitle ?? "IT Department")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />

    <link rel="icon" type="image/x-icon" href="~/logopolytech-1.ico" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
    <header class="header">
        <div class="header-content">
            <div class="logo-and-navigation-buttons">
                <div class="left-side">
                    <div class="logo">
                        <a href="/">
                            <img src="~/images/Dark logo with text.png" alt="Logo"/>
                        </a>
                    </div>
                </div>

                <div class="right-side">
                    <div class="navigation-buttons">
                        <ul>
                            <li><button class="lang-switch" type="button" style="border:none; background:none; cursor:pointer; font-weight:700; color:#4c229bc2;">UA</button></li>

                            @Html.Raw(searchHtml)

                            @Html.Raw(menuHtml)

                            @Html.Raw(loginButtonHtml)
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    <footer class="footer">
        <div class="footer-content">
            <div class="f-left-side">
                <div class="f-logo">
                    <img src="~/images/Footer logo.png" alt="Footer Logo" />
                </div>
            </div>
            <div class="f-center-side">
                <div class="social-media">
                    <a href="#"><img src="svg/Instagram image.svg" alt="Instagram" /></a>
                    <a href="#"><img src="svg/YouTube image.svg" alt="YouTube" /></a>
                    <a href="#"><img src="svg/X image.svg" alt="X" /></a>
                    <a href="#"><img src="svg/Facebook image.svg" alt="Facebook" /></a>
                    <a href="#"><img src="svg/Gmail image.svg" alt="Gmail" /></a>
                    <a href="#"><img src="svg/TikTok image.svg" alt="TikTok" /></a>
                    <a href="#"><img src="svg/Threads image.svg" alt="Threads" /></a>
                </div>
            </div>
            <div class="f-right-side">
                <div class="f-navigation-buttons">
                    <ul>
                        <li><a href="#">Academic</a></li>
                        <li><a href="#">Contact</a></li>
                        @Html.Raw(loginButtonHtml)
                    </ul>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <script>
        const searchInput = document.getElementById("searchInput");
        const suggestionsBox = document.getElementById("suggestionsBox");

        if (searchInput) {
            searchInput.addEventListener("input", async () => {
                const query = searchInput.value.trim();
                if (query.length < 2) {
                    suggestionsBox.innerHTML = "";
                    return;
                }
                try {
                    const res = await fetch(`/Pages/SearchSuggestions?term=${encodeURIComponent(query)}`);
                    if (res.ok) {
                        const suggestions = await res.json();
                        suggestionsBox.innerHTML = suggestions.map(item =>
                            `<a href="/${encodeURIComponent(item.slug)}" style="display:block; padding:10px; text-decoration:none; color:#333; border-bottom:1px solid #eee;">${item.title}</a>`
                        ).join("");
                    }
                } catch (e) { console.error(e); }
            });
            document.addEventListener("click", (e) => {
                if (!e.target.closest('#searchForm')) suggestionsBox.innerHTML = "";
            });
        }
    </script>
</body>
</html>