<!DOCTYPE html>
@inject it_department_site.Services.Interfaces.ISiteSettingsService SettingsService
@inject it_department_site.Services.Interfaces.ICurrentUserService CurrentUserService
@inject it_department_site.Services.Interfaces.IOrganizationInfoService OrgInfoService
@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web

@functions {
    string RenderHtml(IHtmlContent content)
    {
        using var writer = new StringWriter();
        content.WriteTo(writer, HtmlEncoder.Default);
        return writer.ToString();
    }
}

@{
    var siteSettings = await SettingsService.GetAsync();
    var controllerName = ViewContext.RouteData.Values["controller"]?.ToString();
    var isAdminPage = controllerName == "Admin";

    var menuHtml = RenderHtml(await Component.InvokeAsync("Menu"));
}

@{
    var orgInfo = await OrgInfoService.GetAsync();
}

<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @(siteSettings?.SiteTitle ?? "IT Department")</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/fonts/inter/inter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/slider.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/footer.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/partners.css" asp-append-version="true" />
    @if (!isAdminPage)
    {
        <link rel="stylesheet" href="~/css/breadcrumbs.css" asp-append-version="true" />
    }
    @await RenderSectionAsync("Styles", required: false)

    @if (isAdminPage)
    {
        <link rel="stylesheet" href="~/css/adminStyle.css" asp-append-version="true" />
    }

</head>

<body>
    <header class="header">
        <div class="left-side">
            <a class="logo" href="/">
                <img src="~/images/light-logo-with-text.png" alt="Logo"/>
            </a>
        </div>

        <div class="right-side">
            <ul class="main-nav">
                @Html.Raw(menuHtml)
                @if (CurrentUserService.IsAuthenticated && CurrentUserService.IsAdmin) {
                    <li class="divider"></li>
                    <li class="main-nav-item admin-panel">
                        <a asp-controller="Admin" asp-action="Index">Панель адміністатора</a>
                    </li>
                }
            </ul>
            <div class="nav-toggle">
                <span></span>
                <span></span>
                <span></span>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

<footer class="footer">
    @if (!isAdminPage)
    {
        <div class="footer-top">
            <div class="f-container">
                <div class="f-col">
                    <h4>Корисні посилання</h4>
                    <p>Чекаємо вас на нашому офіційному сайті.</p>
                    <div class="f-link-wrap">

                        <a href="https://polytech.cv.ua/" target="_blank" class="f-action-link">
                            <img class="f-link-wrap-icon" src="~/images/logo-polytech.png" alt="polyetch icon">
                            Чернівецький політехнічний фаховий коледж
                        </a>
                    </div>
                </div>

                <div class="f-line"></div>

                <div class="f-col">
                    <h4>Про спеціальність</h4>
                    <p>Інженерія програмного забезпечення — це проектування, розробка та підтримка складних систем. Стань професіоналом майбутнього.</p>
                </div>

                <div class="f-line"></div>


                <div class="f-col">
                    <h4>Ми у соцмережах</h4>
                    <div class="f-insta-grid">

                        <a href="#" class="insta-post-card">
                            <div class="post-img-side">
                                <img src="https://media.istockphoto.com/id/1457290530/photo/asian-teenager-students-doing-robot-arm-and-robotic-cars-homework-project-in-house-using.jpg?s=612x612&w=0&k=20&c=UqJtQbOTZBu6Yw-JB9jHOxpgOCoB5in1W02JuxYlibY=" alt="">
                            </div>
                            <div class="post-text-side">
                                <p class="post-desc">Робота студентів спеціальності ПЗ над проєктом.</p>
                            </div>
                        </a>

                        <a href="#" class="insta-post-card">
                            <div class="post-img-side">
                                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcSm3A06HGYb6XHYZ7lolj6nUV0XPh8YhSQZVA&s" alt="">
                            </div>
                            <div class="post-text-side">
                                <p class="post-desc">Презентація нових розробок в коледжі.</p>
                            </div>
                        </a>

                    </div>
                </div>


                <div class="f-line"></div>

                <div class="f-col">
                    <h4 class="f-contacts-title">Контакти</h4>
                    <div class="f-contact-info">
       			 <p>@orgInfo.Address</p>
                          <p>@string.Join(" | ", orgInfo.PhoneNumbers)</p>
                          <p>@orgInfo.Email</p>
                    </div>
                    <div class="live-map-container">
                        <iframe
                            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2636.568453535!2d25.9221!3d48.2917!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x473408b3f4692599%3A0x16afb3b788bb529d!2z0LLRg9C70LjRhtGPINCf0LDQstC70LAg0JrQsNGB0L_RgNGD0LrQsCwgMiwg0KfQtdGA0L3RltCy0YbRliwg0KfQtdGA0L3RltCy0LXRhtGM0LrQsCDQvtCx0LvQsNGB0YLRjCwgNTgwMDA!5e0!3m2!1suk!2sua!4v1712175000000!5m2!1suk!2sua"
                            width="100%"
                            height="110"
                            style="border:0;"
                            allowfullscreen=""
                            loading="lazy">
                        </iframe>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="footer-bottom">
        <div class="f-logo-area">
            <a class="logo" href="/">
                <img src="~/images/light-logo-with-text.png" alt="Logo"/>
            </a>
        </div>

        <div class="f-info-area">
            <span>© 2026 Чернівецький політехнічний фаховий коледж</span>
        </div>

        <div class="f-social-area">
            <div class="f-soc-list">
              @foreach (var social in orgInfo.SocialLinks)
                {
                    <a href="@social.Url" target="_blank" class="sm-link">
                        <img src="~/images/icons/@social.Icon" alt="@social.Title" />
                    </a>
                }
            </div>
        </div>
    </div>
</footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
