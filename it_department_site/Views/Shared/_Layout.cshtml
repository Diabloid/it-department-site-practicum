<!DOCTYPE html>
@inject ISiteSettingsService SettingsService
@using Microsoft.AspNetCore.Html
@using System.Text.Encodings.Web
@using System.Text.RegularExpressions
@using System.IdentityModel.Tokens.Jwt
@using System.Security.Claims

@functions {
    string RenderHtml(IHtmlContent content)
    {
        using var writer = new StringWriter();
        content.WriteTo(writer, HtmlEncoder.Default);
        return writer.ToString();
    }
}
@{
    var isJwtLoggedIn = Context.Request.Cookies["jwt"] != null;
    var siteSettings = await SettingsService.GetAsync();
    var menuHtml = RenderHtml(await Component.InvokeAsync("Menu"));
    string loginButtonHtml;

    if (isJwtLoggedIn)
    {
        var handler = new JwtSecurityTokenHandler();
        var token = handler.ReadJwtToken(Context.Request.Cookies["jwt"]);
        var role = token.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Role)?.Value ?? "";
        var username = token.Claims.FirstOrDefault(c => c.Type == ClaimTypes.Name)?.Value ?? "";

        if (role == "Admin")
        {
            loginButtonHtml = @"
        <li class='nav-item'>
            <a class='nav-link' href='/Admin/Index'>Адмін Панель</a>
        </li>";
        }
        else if (role == "User")
        {
            loginButtonHtml = @"
        <li class='nav-item'>
            <a class='nav-link' href='/profile'>Профіль</a>
        </li>";
        }
        else
        {
            loginButtonHtml = "<li class='nav-item'><a class='nav-link' href='/Login'>Увійти</a></li>";
        }
    }
    else
    {
        loginButtonHtml = "<li class='nav-item'><a class='nav-link' href='/Login'>Увійти</a></li>";
    }

    var searchHtml = @"
        <li class='nav-item'>
            <form class='d-flex position-relative' id='searchForm' autocomplete='off'>
                <input class='form-control me-sm-2' type='search' id='searchInput' name='query' placeholder='Пошук...' />
                <div id='suggestionsBox' class='list-group position-absolute w-100' style='top:100%; z-index:1000;'></div>
            </form>
        </li>";


}
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @siteSettings.SiteTitle</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/it_department_mvc.styles.css" asp-append-version="true" />
    <link rel="icon" type="image/x-icon" href="D:\It-department-site\it-department-site\It_department_site\wwwroot\logopolytech-1.ico" />

</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" href="/Pages/Index">@(siteSettings?.SiteTitle ?? "Назва сайту")</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent" aria-controls="navbarContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="navbarContent">
                    <ul class="navbar-nav ms-auto">
                        @Html.Raw(searchHtml)
                        @Html.Raw(menuHtml)
                        @Html.Raw(loginButtonHtml)
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="border-top footer text-muted">
        <div class="container">
            @Html.Raw(siteSettings?.FooterHtml ?? "© 2025 IT Department")
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script>
        const searchInput = document.getElementById("searchInput");
        const suggestionsBox = document.getElementById("suggestionsBox");

        if (searchInput) { // Додано перевірку на існування елемента, щоб не було помилок в консолі
            searchInput.addEventListener("input", async () => {
                const query = searchInput.value.trim();
                if (query.length < 2) {
                    suggestionsBox.innerHTML = "";
                    return;
                }

                try {
                    const res = await fetch(`/Pages/SearchSuggestions?term=${encodeURIComponent(query)}`);
                    if (res.ok) {
                        const suggestions = await res.json();
                        suggestionsBox.innerHTML = suggestions.map(item =>
                            `<a href="/${encodeURIComponent(item.slug)}" class="list-group-item list-group-item-action">${item.title}</a>`
                        ).join("");
                    }
                } catch (e) {
                    console.error("Помилка пошуку:", e);
                }
            });

            document.addEventListener("click", () => suggestionsBox.innerHTML = "");
        }
    </script>
</body>
</html>